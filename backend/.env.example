# ─────────────────────────────────────────────────────────────
# GanzAfrica backend environment (copy to .env and fill in)
# Every key here is parsed by src/config/env.ts. Required unless marked optional.
# NEVER commit the real .env — it is gitignored. See docs/architecture/secret-rotation.md.
# ─────────────────────────────────────────────────────────────

# ── Database (Postgres on the droplet) ──
DATABASE_URL=postgresql://user:password@localhost:5432/ganzafrica

# ── Runtime ──
NODE_ENV=development                 # development | test | production
API_PORT=3002
API_BASE_URL=http://localhost:3002  # public base URL of the API; also used to build payslip email links (prod: https://api.ganzafrica.org)
PORT=3002

# ── App URLs (used for CORS + links in emails) ──
WEBSITE_URL=http://localhost:3000
PORTAL_URL=http://localhost:3001
TASK_URL=http://localhost:3003       # optional

# ── Auth secrets (min 32 chars each; rotate together — see FND-06) ──
SESSION_SECRET=change-me-min-32-characters-long-secret
JWT_SECRET=change-me-min-32-characters-long-secret
JWT_REFRESH_SECRET=change-me-min-32-characters-long-secret
ACCESS_TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=30d

# ── Payroll ──
USD_SALARY_EMAILS=                   # optional, comma-separated

# ── Email (SMTP, Azure Communication Services) ──
EMAIL_FROM=it@ganzafrica.org         # optional; defaults to "GanzAfrica <no-reply@ganzafrica.org>"
SMTP_HOST=                           # optional; if unset (or SMTP_USER/SMTP_PASSWORD are), emails are no-ops (logged)
SMTP_PORT=587                        # optional; defaults to 587 (STARTTLS)
SMTP_USER=                           # optional
SMTP_PASSWORD=                       # optional
EMAIL_PORT=                          # optional (legacy alias for SMTP_PORT)

# ── Email (Resend) — unused by the live path, kept only for the dead src/services/hr/email.service.ts ──
RESEND_API_KEY=                      # optional
RESEND_FROM_EMAIL=                   # optional; defaults to "GanzAfrica <no-reply@ganzafrica.org>"

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3004,http://localhost:3005

# ── Azure Blob Storage (file storage) ──
AZURE_STORAGE_ACCOUNT=ganzafricastore
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_ENDPOINT=https://ganzafricastore.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=     # DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_PRIVATE=uploads   # optional; defaults to "uploads" — served only via short-lived SAS links
AZURE_STORAGE_CONTAINER_PUBLIC=public     # optional; defaults to "public" — public-read container
AZURE_STORAGE_CDN_URL=                # optional CDN base for public assets

# ── Google Calendar integration (task app) ──
GOOGLE_CALENDAR_CLIENT_ID=           # optional
GOOGLE_CALENDAR_CLIENT_SECRET=       # optional
GOOGLE_CALENDAR_REDIRECT_URI=        # optional
