{
  "name": "ganzafrica-backend",
  "version": "1.0.0",
  "description": "Ganzafrica backend API",
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reconcile": "tsx scripts/reconcile-db.ts",
    "db:seed:rbac": "tsx scripts/seed-rbac.ts",
    "db:seed:leave": "tsx scripts/seed-leave-defaults.ts",
    "db:seed:onboarding": "tsx scripts/seed-onboarding-template.ts",
    "db:seed:test-users": "tsx scripts/seed-test-users.ts",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "db:set-admin": "tsx scripts/set-admin-user.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "tsx scripts/guard-push.ts",
    "swagger:generate": "tsx src/swagger/generate.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:db:up": "tsx scripts/test-db.ts up",
    "test:db:down": "tsx scripts/test-db.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/lib-storage": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.978.0",
    "@types/multer": "^1.4.13",
    "@types/pdfkit": "^0.17.4",
    "argon2": "^0.41.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.4",
    "drizzle-orm": "^0.39.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "googleapis": "^166.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "otpauth": "^9.3.6",
    "papaparse": "^5.5.2",
    "paseto": "^3.1.4",
    "pdf-parse": "1",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.3",
    "resend": "^6.9.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^20.17.19",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "3",
    "@workspace/eslint-config": "workspace:*",
    "cross-env": "^10.1.0",
    "eslint": "^9.15.0",
    "supertest": "^7.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
